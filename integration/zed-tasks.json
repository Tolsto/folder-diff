    "reveal": "never",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false
  },
  {
    "label": "Folder Diff: Choose both directories",
    "command": "folder-diff",
    "args": ["--choose"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "on_success",
    "show_summary": false,
